{
  "name": "iconic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types worker/worker-configuration.d.ts && tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "data:sheet": "node scripts/contact-sheet.mjs",
    "landcover": "node scripts/build-landcover.mjs",
    "countries": "node scripts/build-countries.mjs",
    "ocean": "node scripts/build-ocean.mjs",
    "og": "node scripts/build-og.mjs",
    "db:sync": "node scripts/db-sync.mjs",
    "deploy": "npm run build && npm run db:sync && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "maplibre-gl": "^6.0.0",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "world-countries": "^5.1.0",
    "wrangler": "^4.167.0"
  }
}
